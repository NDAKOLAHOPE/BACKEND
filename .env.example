NODE_ENV=development
PORT=3000

# Postgres connection (local or Supabase)
# Exemple:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_db
# Pour Supabase (souvent requis):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.yourref.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# JWT
JWT_SECRET=dev_secret_change_me

# Optional: allow ADMIN registration only with this key
ADMIN_CREATE_KEY=

# CORS
# Comma-separated origins
CORS_ORIGIN=http://localhost:5173

